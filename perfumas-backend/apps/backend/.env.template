# Perfumas Medusa Backend — environment
# Copy to apps/backend/.env and fill with your Supabase + secrets.

# Supabase Postgres (Settings → Database → Connection string URI)
# Use the "Transaction" pooler or direct connection. Example:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

DB_NAME=perfumas_medusa

# Storefront (PERFUMAS-E-COMMERCE runs on :3000)
STORE_CORS=http://localhost:3000,https://perfumas.com.co
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000

JWT_SECRET=change-me-jwt-secret
COOKIE_SECRET=change-me-cookie-secret

# Optional Redis (local docker or Upstash)
REDIS_URL=redis://localhost:6379

# Colombia region — set in admin after first boot
# currency: COP
